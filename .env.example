# ===============================================
# Professional Academy — Environment Variables
# انسخ هذا الملف باسم .env ثم املأ القيم
# cp .env.example .env
# ===============================================

# --- قاعدة البيانات (مطلوب) ---
# محلياً:
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
# على Neon / Supabase (إنتاج):
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# --- مفاتيح إشعارات Push (اختياري لكن مُوصى به في الإنتاج) ---
# بدونها يتم توليد مفاتيح مؤقتة تلقائياً وتُفقد عند إعادة النشر
# ولّدها بالأمر:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- بيئة التشغيل ---
NODE_ENV=development
